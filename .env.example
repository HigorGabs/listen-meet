GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production safety: server API keys are ignored by default when NODE_ENV=production.
# Enable only for private/protected deployments.
LISTEN_MEET_ALLOW_SERVER_KEYS=false

# Enable only when the app is behind a trusted reverse proxy that owns x-forwarded-for/x-real-ip.
LISTEN_MEET_TRUST_PROXY_HEADERS=false
